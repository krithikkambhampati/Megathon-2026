# secrets
.env

# raw/interim data never committed (licences, addresses)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# customer memory DB (local only)
data/memory.sqlite

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/
build/

# editors / OS
.vscode/
.idea/
.DS_Store

# Part 1: data stays on the build machine (team decision); regenerate with
# `python -m data_pipeline.run_all` (docs/DATA.md)
data/processed/*
!data/processed/.gitkeep
data/examples/*
!data/examples/.gitkeep
config/generated/*.parquet
