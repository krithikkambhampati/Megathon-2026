# secrets
.env

# raw/interim data never committed (licences, addresses)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# customer memory DB (local only)
data/memory.sqlite
# accounts + login sessions (api/auth.py)
data/app.sqlite*

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/
build/

# editors / OS
.vscode/
.idea/
.DS_Store

# Part 1: data stays on the build machine (team decision); regenerate with
# `python -m data_pipeline.run_all` (docs/DATA.md)
data/processed/*
!data/processed/.gitkeep
# demo homes (test split + PS2 P10001; no addresses) are committed for the UI
data/examples/*
!data/examples/.gitkeep
!data/examples/*.json
config/generated/*.parquet
# Peer percentiles are small train-split aggregates (no addresses); committed so every machine
# compares homes with real peers instead of engine.yaml placeholders.
!config/generated/peer_percentiles.parquet
# Part 3:
# trained models (deliverable C) and held-out predictions (deliverable I) are committed compressed
models/**/*.txt
outputs/test_predictions/*.csv
reports/*.log
