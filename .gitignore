# secrets
.env

# raw/interim data never committed (licences, addresses)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# customer memory DB (local only)
data/memory.sqlite

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/
build/

# editors / OS
.vscode/
.idea/
.DS_Store

# Part 1: data stays on the build machine (team decision); regenerate with
# `python -m data_pipeline.run_all` (docs/DATA.md)
data/processed/*
!data/processed/.gitkeep
data/examples/*
!data/examples/.gitkeep
config/generated/*.parquet
# Peer percentiles are small train-split aggregates (no addresses); committed so every machine
# compares homes with real peers instead of engine.yaml placeholders.
!config/generated/peer_percentiles.parquet
# Part 3: trained models and predictions stay on the build machine (team decision);
# retrain with the training/ scripts (docs/MODELS.md)
models/*
!models/.gitkeep
outputs/test_predictions/*
!outputs/test_predictions/.gitkeep
reports/*.log
