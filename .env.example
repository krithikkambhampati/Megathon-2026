GREENHOME_API_URL=http://localhost:8000
GREENHOME_ENGINE_MODE=engine     # engine | fixture
GREENHOME_MEMORY_DB=data/memory.sqlite
LLM_PROVIDER=openai_compat       # openai_compat (Groq, hosted) | ollama (optional offline) | blank = templates only
LLM_MODEL=                       # blank = pinned model in config/llm.yaml (openai/gpt-oss-120b)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                     # Groq key from console.groq.com: ONLY in .env, never commit it
# Offline alternative: LLM_PROVIDER=ollama  LLM_BASE_URL=http://localhost:11434  LLM_MODEL=<ollama tag>
LLM_TIMEOUT_S=30
LLM_ANSWER_BUDGET_S=25           # whole explain/chat answer, incl. retry; then template
EPC_API_TOKEN=                   # P1: only for data_pipeline.download.epc_bulk
